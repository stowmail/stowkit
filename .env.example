# Stow engine: app configuration (D-007, D-512)
# Copy to ~/Library/Application Support/Stow/config.env (chmod 600) and fill in,
# or name another file with STOW_ENV_FILE. Never commit the filled-in file.
# A .env in the current folder is never read.
# These identify the Stow app to Google and Microsoft. They are not user tokens:
# mailbox tokens and encryption keys live in the macOS Keychain, never here.

# Google: the OAuth client ID and secret of a "Desktop app" client
STOW_GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
STOW_GOOGLE_CLIENT_SECRET=REPLACE_ME

# Microsoft Entra: the app registration's Application (client) ID
STOW_MS_CLIENT_ID=REPLACE_ME
# "common" allows both work and personal Microsoft accounts
STOW_MS_TENANT=common
